+            {SOURCING_ACTION_LABELS[action]}
+          </label>
+        ) : (
+          <a
+            key={action}
+            className="underline"
+            href={`/sase/shortlist/?provider=${encodeURIComponent(slug)}&action=${action}#sourcing-brief`}
+          >
+            {SOURCING_ACTION_LABELS[action]}
+          </a>
+        ),
+      )}
+    </div>
+  );
+}
